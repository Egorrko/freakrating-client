{
  "name": "freakrating-client",
  "productName": "FreakRating",
  "version": "0.1.0",
  "description": "Десктоп-клиент 3D-мира FreakRating",
  "author": {
    "name": "FreakRating",
    "email": "noreply@freakrating.lol"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --url=http://localhost:4000/world",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "build": {
    "appId": "lol.freakrating.client",
    "productName": "FreakRating",
    "executableName": "FreakRating",
    "artifactName": "FreakRating-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FreakRating"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "FreakRating <noreply@freakrating.lol>",
      "synopsis": "Десктоп-клиент 3D-мира FreakRating",
      "artifactName": "FreakRating-${version}-${arch}.${ext}",
      "executableArgs": [
        "--ozone-platform-hint=auto"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "uiohook-napi": "^1.5.5"
  },
  "allowScripts": {
    "uiohook-napi": false,
    "electron-winstaller": false
  },
  "homepage": "https://freakrating.lol"
}
